Для ДЗ используем результат предыдущей ДЗ 4. У нас имеет angie в хостовой ОС ред ос 8.0.2. Два докера с wordpress и mysql. Используем http без TLS.

1) Возможности клиенской оптимизации.

    в файле /etc/angie.conf в секции http добавляем строки

    sendfile       on; # Прямая передача файлов в обход буфера приложений
    tcp_nopush     on; # Отправление заголовков HTTP ответа и начало файла в одном сетевом пакете TCP
    tcp_nodelay    on; # Отправка данные без заполнения буфера пакета в keepalive.
    keepalive_timeout  65; 
    keepalive_requests 1000;

    #Сжатие файлов через gzip
    
    gzip  on;
    gzip_comp_level 5;
    gzip_min_length 256; # Не сжимаем файлы меньше 256 байт
    gzip_proxied any;    # Сжимать запросы, идущие через прокси
    gzip_types text/plain text/css application/javascript application/json image/svg+xml xml/javascript;

   # Адаптивная доставка изображений . Добавляем переменную $img_suffix

        map $http_accept $img_suffix {
        # Сначала проверяем AVIF (как самый эффективный)
        "~*image/avif"  ".avif";
        # Если AVIF не поддерживается, проверяем WebP
        "~*image/webp"  ".webp";
        # Для всех остальных браузеров переменная будет пустой
        default         "";
    }

   в файле /etc/http.d/default.conf в секции Server добавляем 

    # АДАПТИВНАЯ СТАТИКА (Высший приоритет для картинок из uploads)
    # Перехватываем только загруженные пользователем изображения для подмены формата
      location ~* ^/wp-content/uploads/(.+)\.(png|jpg|jpeg)$ {
      add_header Vary Accept;
      expires 365d;
      add_header Cache-Control "public, no-transform";
    
    # Ищем оптимизированный формат, затем оригинал. Если файла вообще нет — отдаем 404
      try_files /wp-content/uploads/$1.$2$img_suffix /wp-content/uploads/$1.$2 =404;
      }

2) Настроить серверное кэширование.

в файле /etc/angie.conf в секции http добавляем строки

    # Определяем настройки кэширования     

    proxy_cache_path /var/www/cache levels=1:2 keys_zone=WP_HTTP_CACHE:50m max_size=2g inactive=60m use_temp_path=off;
    
    # Создаем переменную $no_cache cо значениями 0, когда можно отдавть страницу из КЭШ и 1, когда кэш не используется.    

    map $http_cookie $no_cache {
        default 0;
        ~comment_author_ 1; # Если пользователь оставил комментарий, не использовать кэш.
        ~wordpress_logged_in_ 1; # Если пользователь залогинился под своей УЗ, не использовать кэш
        ~wp-postpass 1; # Отключать КЭШ для страниц с паролем
    }

в файле /etc/http.d/default.conf в секции Server добавляем 


        # Активируем КЭШ.

        proxy_cache WP_HTTP_CACHE;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        
        # Разрешаем использовать старый кэш, если WordPress временно упал или занят
        proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
        proxy_cache_background_update on; # Обновление кэша в фоне
        
        # Если 100 пользователей одновременно запросят одну и ту же страницу, 
        # Angie сделает только 1 запрос к WordPress, а остальным отдаст ответ из кэша
        proxy_cache_lock on; 
        
        # Проверяем куки (не кэшируем админку)
        proxy_cache_bypass $no_cache;
        proxy_no_cache $no_cache;

