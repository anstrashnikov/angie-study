4) Настройте защищенный доступ в любой выбранный location с HTTP-авторизацией и ограничением доступа по IP.

dnf install httpd-tools -y

создаем пользователя в файле

sudo htpasswd -c /etc/angie/.htpasswd admin

добавляем в nano /etc/angie/http.d/default.conf

location /wp-admin/ {
    # Логика: удовлетворять любому из условий (IP или Пароль)
    satisfy any;

    # Разрешаем ваш доверенный IP 
    allow ip тестового компа;
    # Запрещаем все остальные IP для беспарольного входа
    deny all;

    # Включаем HTTP-авторизацию для всех остальных
    auth_basic "Админ-зона. Доступ ограничен.";
    auth_basic_user_file /etc/angie/.htpasswd;

    # Проксирование в контейнер
    proxy_pass http://127.0.0.1:8080;
    }
   
}

