такой метод не поддерживает резервирование. При этом показывается всегда одна и таже страница, в моем случае голубая, так как используется хэш по URL.

3) Произвольная балансировка (random).

cat default.conf 
upstream backend {
    random;
    server 127.0.0.1:9001 down;
    server 127.0.0.1:9002 weight=2; #в два раза больше запросов
    server 127.0.0.1:9003;
    server 127.0.0.1:9000 down;
    zone wp_backend_zone 64k;
}

server {
    listen 80;
    # Логи запросов и ошибок
