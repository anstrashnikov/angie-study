1) содержимое файла /etc/angie.conf
здесь добавлена переменная map

cat angie.conf
user  angie;
worker_processes  auto;
worker_rlimit_nofile 65536;

error_log  /var/log/angie/error.log notice;
pid        /run/angie.pid;

events {
    worker_connections  65536;
}


http {
    include       /etc/angie/mime.types;
    default_type  application/octet-stream;

    log_format  main  '$remote_addr - $remote_user [$time_local] "$request" '
                      '$status $body_bytes_sent "$http_referer" '
                      '"$http_user_agent" "$http_x_forwarded_for"';

    log_format extended '$remote_addr - $remote_user [$time_local] "$request" '
                        '$status $body_bytes_sent "$http_referer" rt="$request_time" '
                        '"$http_user_agent" "$http_x_forwarded_for" '
                        'h="$host" sn="$server_name" ru="$request_uri" u="$uri" '
                        'ucs="$upstream_cache_status" ua="$upstream_addr" us="$upstream_status" '
                        'uct="$upstream_connect_time" urt="$upstream_response_time"';

    access_log  /var/log/angie/access.log  main;

    map $request_uri $asset_cache_header {
        
        ~*\.(?:jpg|png)$ "public, max-age=31536000, immutable"; # 1 год
        ~*\.(?:scss)$    "public, max-age=0, must-revalidate"; # Проверять обновления каждый раз
    }
    
    sendfile        on;
    #tcp_nopush     on;

    keepalive_timeout  65;

    #gzip  on;

    include /etc/angie/http.d/*.conf;
}

2) Содержиое файла настроек сайта /etc/http.d/default.conf

здесь настроены location для разделов с настройками, также настроено перенаправение c директивой internal на 404, настроены return 301 и 302.

cat default.conf 
server {
    listen       80;
    server_name  localhost;

    #access_log  /var/log/angie/host.access.log  main;

    location / {
        root   /var/www/html;
        index  index.html index.htm;
    }

    location /status/ {
        api     /status/;
        allow   127.0.0.1;
        deny    all;
    }

    error_page  404              /404.html;

    location = /404.html {
    root /var/www/html/error;
    internal;
    }
    
    location ~* \.(?:jpg|png)$ {
    root /var/www/html/images;
    
    # кэшировние из map
    
    add_header Cache-Control $asset_cache_header;
    
    # отключаем логирование
    access_log off;
    log_not_found off;
    }

